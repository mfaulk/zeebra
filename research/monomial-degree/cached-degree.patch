+        }
+        let wire = Wire::<N>::deserialize(deserializer)?;
+        Ok(Self::new(&wire.exponents))
+    }
+}
+
+impl<const N: usize> Hash for Monomial<N> {
+    fn hash<H: Hasher>(&self, state: &mut H) {

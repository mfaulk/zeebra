+#[path = "../../../examples/support/h13_delayed.rs"]
+mod h13;
+
+#[derive(Default)]
+struct NarrowPivot {
+    columns: Vec<usize>,
+    values: Vec<u16>,
+}
+impl NarrowPivot {
+    fn from_row<F: FiniteField>(row: &SparseRow<F>) -> Self {
+        Self {
+            columns: row.entries().iter().map(|(c, _)| *c).collect(),
+            values: row
+                .entries()
+                .iter()
+                .map(|(_, v)| v.h13_canonical() as u16)
+                .collect(),
+        }
+    }
+    fn bytes(&self) -> usize {
+        self.columns.capacity() * 8 + self.values.capacity() * 2
+    }
+}
+
+fn h13_eliminate<F: FiniteField>(
+    matrix: &mut SparseMatrix<F>,
+    first: usize,
+    pivots: &mut PivotIndex,
+    stats: &mut EliminationStatistics,
+    resident: &mut usize,
+    limit: usize,
+) -> Result<(), usize> {
+    let diagnostic = std::env::var_os("ZEEBRA_H13_METRICS").is_some();
+    let mut conversion = std::time::Duration::ZERO;
+    let start = diagnostic.then(std::time::Instant::now);
+    let mut cache: Vec<NarrowPivot> = (0..matrix.num_rows())
+        .map(|_| NarrowPivot::default())
+        .collect();
+    for (i, item) in cache.iter_mut().enumerate().take(first) {
+        *item = NarrowPivot::from_row(matrix.row(i));
+    }
+    if let Some(start) = start {
+        conversion += start.elapsed();
+    }
+    let mut accumulator = h13::Delayed::<32003>::new(matrix.num_columns());
+    for index in first..matrix.num_rows() {
+        let row = std::mem::take(&mut matrix.rows_mut()[index]);
+        *resident -= row.nonzeros();
+        let start = diagnostic.then(std::time::Instant::now);
+        accumulator.load(row.entries().iter().map(|(c, v)| (*c, v.h13_canonical())));
+        if let Some(start) = start {
+            conversion += start.elapsed();
+        }
+        let mut new_pivot = false;
+        while let Some((column, factor)) = accumulator.leading() {
+            if let Some(pivot) = pivots.pivot_of(column) {
+                accumulator.subtract(&cache[pivot].columns, &cache[pivot].values, factor);
+                stats.row_operations += 1;
+                let live = *resident + accumulator.nonzeros();
+                stats.peak_nonzeros = stats.peak_nonzeros.max(live);
+                if live > limit {
+                    return Err(live);
+                }
+            } else {
+                pivots.insert(column, index);
+                stats.rank += 1;
+                new_pivot = true;
+                break;
+            }
+        }
+        let start = diagnostic.then(std::time::Instant::now);
+        let entries: Vec<_> = accumulator
+            .take()
+            .into_iter()
+            .map(|(c, v)| (c, F::new(v)))
+            .collect();
+        let mut output = SparseRow::from_sorted_unchecked(entries);
+        if new_pivot {
+            if output.normalize() {
+                stats.pivot_inversions += 1;
+            }
+            cache[index] = NarrowPivot::from_row(&output);
+        }
+        if let Some(start) = start {
+            conversion += start.elapsed();
+        }
+        if output.is_zero() {
+            stats.zero_rows += 1;
+        }
+        *resident += output.nonzeros();
+        stats.peak_nonzeros = stats.peak_nonzeros.max(*resident);
+        matrix.rows_mut()[index] = output;
+    }
+    if diagnostic {
+        let cache_bytes = cache.capacity() * std::mem::size_of::<NarrowPivot>()
+            + cache.iter().map(NarrowPivot::bytes).sum::<usize>();
+        eprintln!(
+            "h13 conversion_ns={} pivot_cache_bytes={} accumulator_bytes={}",
+            conversion.as_nanos(),
+            cache_bytes,
+            matrix.num_columns() * 8
+        );
+    }
+    Ok(())
+}

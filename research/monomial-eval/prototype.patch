+struct SmallChains;
+impl Route for SmallChains {
+    fn pow<F: FiniteField>(a: &F, b: u128) -> F {
+        match b {
+            0 => F::one(),
+            1 => *a,
+            2 => *a * *a,
+            3 => (*a * *a) * *a,
+            4 => {
+                let square = *a * *a;
+                square * square
+            }
+            5 => {
+                let square = *a * *a;
+                (square * square) * *a
+            }
+            _ => a.pow(b),
+        }
+    }
+}

#!/usr/bin/env python3
"""Durable benchmark jobs: submit a manifest, run it later, read a complete result (#967).

    tools/bench-job submit <manifest.json>        validate, copy binaries, queue; prints the job id
    tools/bench-job status [job-id] [--json]
    tools/bench-job run (<job-id> | --next)       foreground; background it yourself
    tools/bench-job resume <job-id> [--force-uncancel]
    tools/bench-job cancel <job-id>
    tools/bench-job report <job-id> [--json] [--baseline ARM] [--bound 1.05]
    tools/bench-job scoreboard <job-id> [--machine NAME] [--append history.json]

A job is a directory under $ZEEBRA_BENCH_JOBS (default /buildcache/bench-jobs), never $HOME or a
worktree. The manifest is frozen at submit and names the job (first 12 hex of its SHA-256); every
attempt is an exit record in a `StudyJournal` (tools/external/attempt_journal.py), so the journal,
not this script, is the result. There is no daemon: `run` is an ordinary process under
`bench-reserve run`, which takes the CCD-scoped benchlock for the whole job, and a SIGKILLed runner
loses at most the attempt in flight, which `resume` re-runs because its exit never became durable.
"""
import argparse
import datetime
import fcntl
import hashlib
import importlib.util
import json
import os
import re
import resource
import shutil
import signal
import subprocess
import sys
import statistics as stats
import time
from collections import defaultdict
from pathlib import Path

TOOLS = Path(__file__).resolve().parent
ROOT = TOOLS.parent
SCHEMA = 'bench-job-manifest-v1'
MODES = ('dev', 'publication')
DEFAULT_ROOT = '/buildcache/bench-jobs'
NAME = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._/-]*$')
HEX = re.compile(r'^[0-9a-f]+$')
RETRYABLE = ('failed', 'timeout', 'rss-limit')
EXIT_REFUSED, EXIT_CANCELLED, EXIT_BUSY, EXIT_USAGE = 3, 4, 75, 64


def _module(name, path):
    spec = importlib.util.spec_from_file_location(name, path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


aj = _module('attempt_journal', TOOLS / 'external' / 'attempt_journal.py')
campaign = _module('bench_campaign', TOOLS / 'bench_campaign.py')
bc = _module('bench_contamination', TOOLS / 'bench_contamination.py')
bs = _module('bench_stats', TOOLS / 'bench_stats.py')


class JobError(Exception):
    def __init__(self, message, code=EXIT_USAGE):
        super().__init__(message)
        self.code = code


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=False).encode()


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for block in iter(lambda: f.read(1 << 20), b''):
            h.update(block)
    return h.hexdigest()


def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds')


def jobs_root():
    root = Path(os.environ.get('ZEEBRA_BENCH_JOBS', DEFAULT_ROOT)).resolve()
    for name, base in (('$HOME', Path.home().resolve()), ('the repository', ROOT)):
        if root == base or base in root.parents:
            raise JobError(f'job root {root} is under {name.lstrip("$")}: '
                           f'runtime state belongs on /buildcache (CLAUDE.md §1); set ZEEBRA_BENCH_JOBS')
    return root


def job_dir(job_id):
    if not re.fullmatch(r'[0-9a-f]{12}', job_id or ''):
        raise JobError(f'{job_id!r} is not a job id (12 hex digits)')
    d = jobs_root() / job_id
    if not (d / 'manifest.json').is_file():
        raise JobError(f'no job {job_id} under {jobs_root()}')
    return d


def expand_cpus(cpus):
    out = []
    for part in str(cpus).split(','):
        m = re.fullmatch(r'(\d+)(?:-(\d+))?', part)
        if not m or (m[2] and int(m[2]) < int(m[1])):
            raise JobError(f'malformed cpu list {cpus!r}')
        out += range(int(m[1]), int(m[2] or m[1]) + 1)
    return out


def compress_cpus(ids):
    runs = []
    for c in ids:
        if runs and c == runs[-1][1] + 1:
            runs[-1][1] = c
        else:
            runs.append([c, c])
    return ','.join(str(a) if a == b else f'{a}-{b}' for a, b in runs)


# ------------------------------------------------------------------------------------------------
# Manifest: validation and the deterministic plan.
# ------------------------------------------------------------------------------------------------

def _require(cond, message):
    if not cond:
        raise JobError(f'manifest: {message}')


def _source_problem(binary, commit):
    """Why a binary cannot be trusted to be `commit`, or None. A binary outside any git checkout is
    judged by its recipe alone; one inside a checkout must sit in a clean tree at that commit."""
    git = lambda *a: subprocess.run(['git', '-C', str(binary.parent), *a], capture_output=True, text=True)
    if git('rev-parse', '--show-toplevel').returncode != 0:
        return None
    if git('status', '--porcelain', '--untracked-files=no').stdout.strip():
        return f'{binary} was built in a dirty tree'
    head = git('rev-parse', 'HEAD').stdout.strip()
    if not head.startswith(commit):
        return f'{binary} sits in a checkout at {head[:12]}, not {commit[:12]}'
    return None


def validate(m):
    _require(isinstance(m, dict) and m.get('schema') == SCHEMA, f'schema must be {SCHEMA!r}')
    _require(m.get('mode') in MODES, f'mode must be one of {MODES}, not {m.get("mode")!r}')
    ctx = m.get('context') or {}
    _require(isinstance(ctx.get('issue'), int) and isinstance(ctx.get('agent'), str),
             'context needs an integer issue and the agent id (scripts/agent/zb-claim.sh id)')
    arms, instances, run = m.get('arms') or [], m.get('instances') or [], m.get('run') or {}
    _require(arms and instances, 'arms and instances must both be non-empty')
    for kind, items in (('arm', arms), ('instance', instances)):
        names = [i.get('name') for i in items]
        _require(all(isinstance(n, str) and NAME.match(n) and '..' not in n for n in names),
                 f'every {kind} needs a plain name')
        _require(len(set(names)) == len(names), f'{kind} names must be unique')
    for arm in arms:
        name, commit, build = arm['name'], str(arm.get('commit', '')), arm.get('build') or {}
        _require(HEX.match(commit) and 7 <= len(commit) <= 40, f'arm {name}: commit must be a hex sha')
        _require(all(isinstance(build.get(k), str) for k in ('profile', 'flags', 'recipe')),
                 f'arm {name}: build needs profile, flags and recipe')
        _require(f'git archive {commit}' in build['recipe'],
                 f'arm {name}: the build recipe must record `git archive {commit}`; a job never builds')
        _require(isinstance(arm.get('argv'), list) and all(isinstance(a, str) for a in arm['argv']),
                 f'arm {name}: argv must be a list of strings')
        binary = Path(arm.get('binary', ''))
        _require(binary.is_absolute() and binary.is_file() and os.access(binary, os.X_OK),
                 f'arm {name}: binary must be an absolute path to an executable')
        _require(sha256_file(binary) == arm.get('sha256'), f'arm {name}: {binary} does not match its sha256')
        problem = _source_problem(binary, commit)
        _require(problem is None, f'arm {name}: {problem}')
    for inst in instances:
        if inst.get('path') is not None:
            path = Path(inst['path'])
            _require(path.is_absolute() and path.is_file(), f'instance {inst["name"]}: path must be an absolute file')
            _require(sha256_file(path) == inst.get('sha256'), f'instance {inst["name"]}: input does not match its sha256')
        _require(isinstance(inst.get('params', {}), dict), f'instance {inst["name"]}: params must be an object')
    limits = run.get('limits') or {}
    cpus = expand_cpus(run.get('cpus', ''))
    workers = run.get('workers')
    _require(isinstance(workers, list) and workers and all(isinstance(w, int) and 0 < w <= len(cpus) for w in workers),
             'run.workers must be positive and fit in run.cpus')
    _require(isinstance(run.get('repetitions'), int) and run['repetitions'] > 0, 'run.repetitions must be >= 1')
    _require(run.get('interleave', 'rotate') == 'rotate', 'run.interleave supports only "rotate"')
    _require(all(isinstance(s, int) for s in run.get('seeds', [0])), 'run.seeds must be integers')
    _require(isinstance(run.get('retries', 0), int) and run.get('retries', 0) >= 0, 'run.retries must be >= 0')
    _require(isinstance(run.get('mode_wait_seconds', 0), (int, float)) and run.get('mode_wait_seconds', 0) >= 0,
             'run.mode_wait_seconds must be >= 0')
    _require(isinstance(limits.get('wall_seconds'), (int, float)) and limits['wall_seconds'] > 0,
             'run.limits.wall_seconds must be positive')
    for key in ('rss_bytes', 'live_bytes'):
        _require(limits.get(key) is None or isinstance(limits[key], int), f'run.limits.{key} must be an integer or null')
    for cell in expand(m):
        argv(m, cell, Path('/job'))


def expand(m):
    """The plan: instances x workers x seeds in turn, arms rotated one place per repetition."""
    run = m['run']
    rows = [(dict(instance=i['name'], workers=w, seed=s), [a['name'] for a in m['arms']])
            for i in m['instances'] for w in run['workers'] for s in run.get('seeds', [0])]
    return [dict(row, rep=rep, arm=arm) for rep, row, arm in campaign.plan(rows, run['repetitions'])]


def attempt_id(job_id, index, try_):
    return f'{job_id}:{index}:{try_}'


def _key(name):
    return name.replace('/', '__')


def binary_path(directory, arm):
    return directory / 'bin' / _key(arm['name']) / Path(arm['binary']).name


def input_path(directory, inst):
    return directory / 'inputs' / _key(inst['name']) / Path(inst['path']).name if inst.get('path') else None


def attempt_cpus(m, workers):
    return compress_cpus(expand_cpus(m['run']['cpus'])[:workers])


def argv(m, cell, directory):
    arm = next(a for a in m['arms'] if a['name'] == cell['arm'])
    inst = next(i for i in m['instances'] if i['name'] == cell['instance'])
    values = dict(inst.get('params', {}), instance=inst['name'], input=str(input_path(directory, inst) or ''),
                  workers=cell['workers'], seed=cell['seed'], rep=cell['rep'], cpus=attempt_cpus(m, cell['workers']),
                  wall_seconds=m['run']['limits']['wall_seconds'], live_bytes=m['run']['limits'].get('live_bytes'))
    try:
        return [str(binary_path(directory, arm)), *(a.format_map(values) for a in arm['argv'])]
    except (KeyError, IndexError, ValueError) as e:
        raise JobError(f'manifest: arm {arm["name"]} argv template names an unknown field {e}') from None


def journal_limits(m):
    run, limits = m['run'], m['run']['limits']
    per_try = limits['wall_seconds'] + limits.get('kill_after_seconds', 60)
    attempts = len(expand(m)) * (1 + run.get('retries', 0))
    return dict(aggregate_wall_seconds=limits.get('aggregate_wall_seconds', attempts * per_try),
                output_bytes=limits.get('output_bytes', 1 << 30))


def journal_header(job_id, m):
    return dict(bench_job=dict(job_id=job_id, manifest_sha256=hashlib.sha256(canonical(m)).hexdigest(),
                               mode=m['mode'], context=m['context']))


def open_journal(directory, m):
    return aj.StudyJournal.open(directory / 'journal', journal_header(directory.name, m), expand(m),
                                journal_limits(m), quarantine_torn=True)


# ------------------------------------------------------------------------------------------------
# submit / status / cancel / report.
# ------------------------------------------------------------------------------------------------

def submit(path):
    m = json.loads(Path(path).read_text())
    validate(m)
    root = jobs_root()
    job_id = hashlib.sha256(canonical(m)).hexdigest()[:12]
    final, stage = root / job_id, root / f'.{job_id}.partial'
    if final.exists():
        raise JobError(f'job {job_id} was already submitted; a manifest names exactly one job')
    try:
        root.mkdir(parents=True, exist_ok=True)
    except PermissionError:
        raise JobError(f'cannot create {root}; /buildcache is root-owned, so create it once with '
                       f'`sudo install -d -o "$USER" {root}` or set ZEEBRA_BENCH_JOBS') from None
    shutil.rmtree(stage, ignore_errors=True)
    stage.mkdir()
    for arm in m['arms']:
        _install(Path(arm['binary']), binary_path(stage, arm), arm['sha256'])
    for inst in m['instances']:
        if inst.get('path'):
            _install(Path(inst['path']), input_path(stage, inst), inst['sha256'])
    (stage / 'manifest.json').write_bytes(canonical(m) + b'\n')
    aj.StudyJournal.create(stage / 'journal', journal_header(job_id, m), expand(m), journal_limits(m))
    stage.rename(final)
    with open(root / 'queue', 'a') as q:
        fcntl.flock(q, fcntl.LOCK_EX)
        q.write(f'{now()} {job_id}\n')
    return job_id


def _install(source, target, digest):
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source, target)
    target.chmod(0o555 if os.access(source, os.X_OK) else 0o444)
    if sha256_file(target) != digest:
        raise JobError(f'{source} changed while it was being copied')


def load_manifest(directory):
    return json.loads((directory / 'manifest.json').read_bytes())


def _lock_free(directory):
    with open(directory / 'run.lock', 'a') as f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return False
        return True


def _alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    return True


def job_status(directory):
    """State, outcome counts and the attempt in flight, from the chain-checked journal."""
    m = load_manifest(directory)
    out = dict(job=directory.name, mode=m['mode'], issue=m['context']['issue'], plan=len(expand(m)))
    try:
        header, header_sha = aj._read_header(directory / 'journal')
        entries, _ = aj._entries(directory / 'journal', header_sha)
        attempts, _, stop, _ = aj._replay(directory / 'journal', header, entries)
    except ValueError as e:
        attempts, stop, out['journal_error'] = [], None, str(e)
    outcomes = {}
    for a in attempts:
        outcomes[a['status']] = outcomes.get(a['status'], 0) + 1
    out.update(outcomes=outcomes, stop=stop)
    started = directory / 'started'
    if stop is not None:
        out['state'] = {'complete': 'done', 'cancelled': 'cancelled'}.get(stop['reason'], 'failed')
    elif not _lock_free(directory):
        out['state'] = 'running'
        try:
            current = json.loads((directory / 'current.json').read_text())
            out['current'] = dict(current, elapsed_seconds=round(time.time() - current['started_unix'], 1))
        except (OSError, ValueError):
            pass
    elif not started.exists():
        out['state'] = 'queued'
    else:
        pid = int(started.read_text().split()[0] or 0)
        out['state'] = 'waiting-for-lock' if _alive(pid) else 'interrupted'
    if (directory / 'cancel').exists() and out['state'] != 'cancelled':
        out['cancel_requested'] = True
    return out


def _status_line(s):
    counts = ' '.join(f'{k}={v}' for k, v in sorted(s['outcomes'].items())) or 'none'
    line = f"{s['job']}  {s['state']:<16} #{s['issue']} {s['mode']:<11} attempts {counts} of {s['plan']} cells"
    if 'current' in s:
        line += f"  current {s['current']['attempt']} {s['current']['elapsed_seconds']}s"
    if s.get('stop') and s['state'] == 'failed':
        line += f"  stop={s['stop']['reason']}"
    return line


def cancel(directory):
    """A live runner sees the request and stops; with none, the stop is journaled here and now."""
    with open(directory / 'run.lock', 'a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            pass
        else:
            journal = open_journal(directory, load_manifest(directory))
            if journal.stopped:
                return 'already stopped'
            journal.record_stop('cancelled', at=now(), boundary='not-running')
            return 'cancelled'
    aj._atomic_write(directory / 'cancel', f'{now()} {os.getpid()}\n'.encode())
    return 'cancel requested; the runner stops within 10 s'


def _child_report(attempt):
    """The child's JSON report (its last stdout line), or {} when it printed none."""
    try:
        value = json.loads(attempt['stdout'].decode().strip().splitlines()[-1])
    except (ValueError, IndexError, UnicodeDecodeError):
        return {}
    return value if isinstance(value, dict) else {}


def _flagged(state):
    """Contaminated attempt ids: the session verdict once complete, else each attempt's own."""
    session = (state['stop'] or {}).get('contamination')
    if session:
        return set(session.get('flagged') or {})
    return {a['metadata']['attempt_id'] for a in state['attempts']
            if (((a['metadata'].get('contamination') or {}).get('verdict')) or {}).get('contaminated')}


def _median(values):
    return stats.median(values) if values else None


def summarize(state, m, *, baseline=None, bound=1.05):
    """The report as data. Contaminated attempts are counted and listed but never timed (#968)."""
    flagged, job = _flagged(state), state['header']['bench_job']
    base = baseline or m['arms'][0]['name']
    timed = defaultdict(lambda: defaultdict(dict))  # (instance, workers) -> arm -> (seed, rep) -> sample
    digests, verification, statuses = defaultdict(set), [], defaultdict(int)
    for a in state['attempts']:
        md, cell, child = a['metadata'], a['cell'], _child_report(a)
        statuses[a['status']] += 1
        verification.append(dict(attempt=md['attempt_id'], arm=cell['arm'], instance=cell['instance'],
                                 workers=cell['workers'], rep=cell['rep'], status=a['status'],
                                 contaminated=md['attempt_id'] in flagged, basis_sha256=child.get('basis_sha256')))
        if a['status'] == 'ok' and child.get('basis_sha256'):
            digests[cell['instance']].add(child['basis_sha256'])  # contamination spoils a time, not an answer
        if a['status'] != 'ok' or md['attempt_id'] in flagged:
            continue
        stages = {k[:-3]: v / 1e6 for k, v in (child.get('statistics') or {}).items()
                  if k.endswith('_ns') and isinstance(v, (int, float))}
        timed[(cell['instance'], cell['workers'])][cell['arm']][(cell['seed'], cell['rep'])] = dict(
            wall_ms=md['process_wall_ns'] / 1e6, rss=md.get('observed_peak_rss_bytes'), stages=stages, child=child)
    cells, ratios = [], []
    for (inst, w), arms in sorted(timed.items()):
        for arm, samples in arms.items():
            s = list(samples.values())
            names = sorted({k for x in s for k in x['stages']})
            cells.append(dict(instance=inst, workers=w, arm=arm, n=len(s),
                              wall_ms=_median([x['wall_ms'] for x in s]),
                              rss_mib=_median([x['rss'] / 2**20 for x in s if x['rss']]),
                              stages_ms={k: _median([x['stages'][k] for x in s if k in x['stages']]) for k in names}))
        for arm in (a for a in arms if a != base and base in arms):
            pairs = bs.paired_ratios({k: v['wall_ms'] for k, v in arms[arm].items()},
                                     {k: v['wall_ms'] for k, v in arms[base].items()})
            if not pairs:
                continue
            ci = bs.paired_ratio(pairs, seed=f'{inst} {w} {arm} {base}')
            ratios.append(dict(instance=inst, workers=w, arm=arm, baseline=base, bound=bound, **ci._asdict(),
                               verdict=bs.regression_verdict(ci, bound)._asdict()))
    stop = state['stop'] or {}
    session = stop.get('contamination') or {}
    clocks = sorted({str((a['metadata'].get('before') or {}).get('clock')) for a in state['attempts']})
    return dict(
        provenance=dict(job_id=job['job_id'], mode=job['mode'], context=job['context'],
                        manifest_sha256=job['manifest_sha256'], journal_sha256=state['journal_sha256'],
                        stop=stop.get('reason'), cpus=m['run']['cpus'], clock=clocks,
                        median_khz=session.get('median_khz'),
                        reservation='exclusive' if job['mode'] == 'publication' else 'ccd-scoped',
                        arms=[dict(name=a['name'], commit=a['commit'], sha256=a['sha256'], **a['build'])
                              for a in m['arms']]),
        counts=dict(attempts=len(state['attempts']), statuses=dict(statuses), contaminated=len(flagged),
                    void=bool(session.get('void')), stopped=stop.get('reason') != 'complete',
                    inconclusive=sum(r['verdict']['outcome'] == 'inconclusive' for r in ratios)),
        cells=cells, ratios=ratios, digests={k: sorted(v) for k, v in sorted(digests.items())},
        verification=verification, timed=timed)


def _fmt(value, spec='.1f'):
    return '—' if value is None else format(value, spec)


def render(doc):
    p, c = doc['provenance'], doc['counts']
    out = [f"# bench-job {p['job_id']} ({p['mode']})\n", '## Provenance\n',
           f"- issue #{p['context']['issue']}, agent `{p['context']['agent']}`; stop: {p['stop']}",
           f"- manifest `{p['manifest_sha256']}`, journal `{p['journal_sha256']}`",
           f"- cpus {p['cpus']}, reservation {p['reservation']}, clock {', '.join(p['clock'])}, "
           'median clock (kHz) ' + (', '.join(f'{k} {_fmt(v, ".0f")}' for k, v in (p['median_khz'] or {}).items()) or '—'), '', '| arm | commit | sha256 | profile | flags |',
           '|---|---|---|---|---|']
    out += [f"| {a['name']} | `{a['commit'][:12]}` | `{a['sha256'][:16]}` | {a['profile']} | {a['flags']} |"
            for a in p['arms']]
    out += ['\n## Attempts\n',
            f"{c['attempts']} attempts: " + ', '.join(f'{k} {v}' for k, v in sorted(c['statuses'].items()))
            + f"; contaminated {c['contaminated']} (excluded from timing){', session VOID' if c['void'] else ''}; "
            f"{'stopped before complete' if c['stopped'] else 'complete'}; inconclusive ratios {c['inconclusive']}.",
            '\n## Wall and RSS (medians of clean ok attempts)\n', '| instance | w | arm | n | wall ms | RSS MiB |',
            '|---|---:|---|---:|---:|---:|']
    out += [f"| {r['instance']} | {r['workers']} | {r['arm']} | {r['n']} | {_fmt(r['wall_ms'], ',.2f')} | "
            f"{_fmt(r['rss_mib'])} |" for r in doc['cells']]
    out += ['\n## Stages (median ms, where the child reports them)\n']
    out += [f"- {r['instance']} @{r['workers']} {r['arm']}: "
            + ', '.join(f'{k} {v:,.2f}' for k, v in r['stages_ms'].items())
            for r in doc['cells'] if r['stages_ms']] or ['None reported.']
    out += ['\n## Scaling (median wall ms by workers; speedup over the fewest)\n']
    curves = defaultdict(dict)
    for r in doc['cells']:
        curves[(r['instance'], r['arm'])][r['workers']] = r['wall_ms']
    for (inst, arm), curve in sorted(curves.items()):
        first = curve[min(curve)]
        out.append(f'- {inst} {arm}: ' + ', '.join(f'{w}w {v:,.2f} ({first / v:.2f}x)' for w, v in sorted(curve.items())))
    out += ['\n## Ratios (paired per repetition, 95% bootstrap; tools/bench_stats.py)\n',
            '| instance | w | arm ÷ baseline | n | ratio [95%] | bound | verdict |', '|---|---:|---|---:|---:|---:|---|']
    out += [f"| {r['instance']} | {r['workers']} | {r['arm']} ÷ {r['baseline']} | {r['n']} | {r['median']:.3f} "
            f"[{r['lo']:.3f}, {r['hi']:.3f}] | {r['bound']} | {r['verdict']['outcome']} ({r['verdict']['reason']}"
            f"{'; extend once' if r['verdict']['extend'] else ''}) |" for r in doc['ratios']] or ['No paired arms.']
    out += ['\n## Verification\n']
    out += [f"- {inst}: {'consistent' if len(d) == 1 else 'DIVERGENT'} ({', '.join(x[:16] for x in d)})"
            for inst, d in doc['digests'].items()] or ['No child reported a basis digest.']
    out += [f"- `{v['attempt']}` {v['arm']} {v['instance']} @{v['workers']} rep {v['rep']}: {v['status']}"
            f"{', contaminated' if v['contaminated'] else ''}"
            for v in doc['verification'] if v['status'] != 'ok' or v['contaminated']]
    return '\n'.join(out) + '\n'


def competitive_rows(state, m, *, machine):
    """`CompetitiveRecord` rows (src/grobner/external/board.rs) for a publication job: one per
    instance carrying a `competitive` identity block, arm and worker count."""
    if m['mode'] != 'publication':
        raise JobError('only a publication-mode job feeds the scoreboard (plan §11.2)', EXIT_REFUSED)
    doc, rows, limits = summarize(state, m), [], m['run']['limits']
    job_id = doc['provenance']['job_id']
    for inst in (i for i in m['instances'] if i.get('competitive')):
        for arm in m['arms']:
            for w in m['run']['workers']:
                samples = list(doc['timed'].get((inst['name'], w), {}).get(arm['name'], {}).values())
                row = dict(schema=1, **inst['competitive'], library=arm.get('library', 'zeebra'),
                           library_version=arm.get('library_version'),
                           environment=dict(commit=arm['commit'][:8], base_commit='', patch_id='', machine=machine,
                                            cpu=f'affinity {attempt_cpus(m, w)}', concurrency=w,
                                            build=f"{arm['build']['profile']}, {arm['build']['flags']}",
                                            policy=f'bench-job {job_id}: median of {len(samples)} clean attempts, '
                                                   f"{limits['wall_seconds']} s wall, {w} workers"),
                           limits=dict(wall_nanos=int(limits['wall_seconds'] * 1e9), workers=w,
                                       max_rss_bytes=limits.get('rss_bytes'), tool_caps=[]),
                           reproduce=f'tools/bench-job report {job_id}')
                if not samples:
                    row.update(outcome='failed', outcome_detail='no clean complete attempt')
                else:
                    names = sorted({k for s in samples for k in s['stages']})
                    row.update(outcome='complete', wall_nanos=round(_median([s['wall_ms'] for s in samples]) * 1e6),
                               cpu_basis='unavailable', peak_rss_bytes=round(_median([s['rss'] for s in samples])),
                               peak_rss_basis='direct-child VmHWM (exact)',
                               stages=[dict(name=k, elapsed_nanos=round(_median(
                                   [s['stages'][k] for s in samples if k in s['stages']]) * 1e6)) for k in names])
                    if samples[0]['child'].get('invariants'):
                        row['invariants'] = samples[0]['child']['invariants']
                rows.append(row)
    return rows


def append_history(path, rows):
    """Append to a `history.json` (APPEND-ONLY under COMPETITIVE_HISTORY_CONTRACT); re-render it
    afterwards with `cargo run --release --example competitive -- --write`."""
    history = json.loads(Path(path).read_text())
    history['rows'] += rows
    history['row_count'] = len(history['rows'])
    aj._atomic_write(Path(path), (json.dumps(history, indent=2, ensure_ascii=False) + '\n').encode())


# ------------------------------------------------------------------------------------------------
# The runner.
# ------------------------------------------------------------------------------------------------

def lock_owner(job_id):
    return f'bench-job-{job_id}'


def enforce_mode(m, journal, job_id):
    """Publication mode starts only once the §11.2 start conditions hold (tools/bench_contamination.py),
    re-checking every 60 s for up to `run.mode_wait_seconds`; otherwise the refusal is journaled. Dev
    mode refuses nothing: its context is recorded per attempt."""
    if m['mode'] != 'publication':
        return
    deadline = time.monotonic() + m['run'].get('mode_wait_seconds', 0)
    while True:
        snap = campaign.snapshot(m['run']['cpus'])
        refusals = bc.publication_refusals(snap, lock_owner(job_id)) if 'stat' in snap \
            else [f'cpu-context failed: {snap}']
        if not refusals:
            return
        if time.monotonic() + 60 > deadline:
            with Deferred():
                journal.record_stop('mode-refused', at=now(), refusals=refusals)
            raise JobError(f'publication mode refused: {"; ".join(refusals)}', EXIT_REFUSED)
        time.sleep(60)


def contamination(result, m, job_id):
    """The §11.2 per-attempt record stored in the exit metadata. The clock rule needs the session
    median, so it is applied at the end by `session_contamination`."""
    before, after = result['before'], result['after']
    if not all('stat' in s for s in (before, after)):
        return dict(mode=m['mode'], verdict=None, error='cpu-context snapshots unusable')
    freq = result.get('freq')
    metrics = bc.attempt_metrics(before, after, own_cpu_s=result.get('own_cpu_s', result['cpu_seconds']),
                                 khz_samples=[freq['median_khz']] if freq else None)
    return dict(mode=m['mode'], metrics=metrics, verdict=bc.attempt_verdict(metrics, m['mode'], owner=lock_owner(job_id)))


def harness_cpus(m, cpus):
    """CPUs of run.cpus the attempt does not use, where the runner's own snapshots and sampler go."""
    return set(expand_cpus(m['run']['cpus'])) - set(expand_cpus(cpus))


def _cpu_used():
    return sum(u.ru_utime + u.ru_stime for u in map(resource.getrusage, (resource.RUSAGE_SELF,
                                                                         resource.RUSAGE_CHILDREN)))


def run_attempt(m, command, cpus, guard, cancel_file, directory):
    """`run_child`, with the harness kept off the attempt's CPUs where it can be. A cpu-context
    snapshot costs ~0.5 CPU-s, inside the window its /proc/stat reads bound: on a 0.3 s 16-worker
    attempt that alone exceeds the 5% rule. Where no CPU is spare, the harness's CPU time is
    counted as own time (`own_cpu_s`), which can hide at most that much foreign time."""
    spare, saved = harness_cpus(m, cpus), os.sched_getaffinity(0)
    if spare:
        os.sched_setaffinity(0, spare)  # this thread only; the snapshot children and sampler inherit it
    used = _cpu_used()
    try:
        r = campaign.run_child(command, cpus, m['run']['limits']['wall_seconds'],
                               m['run']['limits'].get('kill_after_seconds', 60), guard,
                               should_stop=cancel_file.exists, scratch_dir=directory / 'scratch')
    finally:
        os.sched_setaffinity(0, saved)
    harness = max(0.0, _cpu_used() - used - r['cpu_seconds'])
    r.update(harness_cpu_seconds=harness, own_cpu_s=r['cpu_seconds'] + (0.0 if spare else harness))
    return r


def cell_group(cell):
    return f"{cell['instance']}@{cell['workers']}w"


def session_contamination(journal, m, job_id):
    """Every judged attempt against its cell's median clock (instance and workers: 1 and 16 workers
    run at different clocks by design, #827, and so do two instances), and whether the session is void."""
    rows = [(a['metadata']['attempt_id'], cell_group(a['cell']), a['metadata'].get('contamination') or {})
            for a in aj.load(journal.directory)['attempts']]
    rows = [r for r in rows if r[2].get('metrics')]
    s = bc.session_verdict([r[2]['metrics'] for r in rows], m['mode'], [r[1] for r in rows], lock_owner(job_id))
    flagged = {aid: v['reasons'] for (aid, _, _), v in zip(rows, s['attempts']) if v['contaminated']}
    return dict(contaminated=s['contaminated'], total=s['total'], void=s['void'], median_khz=s['median_khz'],
                flagged=flagged)


def classify(metadata):
    if metadata['exit'] == 0:
        return 'ok'
    if metadata['stop'] == 'cancelled':
        return 'cancelled'
    if metadata['guard'].get('rss_guard_rc') == 3:
        return 'rss-limit'
    if metadata['exit'] in (124, 137) and metadata['wall_seconds'] >= metadata['guard']['wall_seconds']:
        return 'timeout'
    return 'failed'


class Deferred:
    """Hold SIGINT/SIGTERM while a record is being written, so an operator's signal cannot tear one."""

    def __enter__(self):
        signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGINT, signal.SIGTERM})

    def __exit__(self, *_):
        signal.pthread_sigmask(signal.SIG_UNBLOCK, {signal.SIGINT, signal.SIGTERM})


def _next_work(journal, retries):
    """(index, try) to run next, or None. A cancelled try is always re-run; a failed one while the
    manifest's retry budget lasts; anything else moves on to the first index without an exit."""
    if journal.attempts:
        last = journal.attempts[-1]
        status = last['status']
        if status == 'cancelled' or (status in RETRYABLE and last['try'] < retries):
            return last['index'], last['try'] + 1
    if journal.next_index < len(journal.header['plan']):
        return journal.next_index, 0
    return None


def run_job(directory, force_uncancel=False):
    m = load_manifest(directory)
    lock = open(directory / 'run.lock', 'a')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise JobError(f'job {directory.name} is already running', EXIT_BUSY) from None
    journal = open_journal(directory, m)
    cancel_file = directory / 'cancel'
    if force_uncancel:
        cancel_file.unlink(missing_ok=True)
    if journal.stopped:
        reason = aj.load(directory / 'journal')['stop']['reason']
        if reason == 'complete':
            return 0
        if reason != 'cancelled' or not force_uncancel:
            hint = ' (resume --force-uncancel to continue)' if reason == 'cancelled' else ''
            raise JobError(f'job {directory.name} is stopped: {reason}{hint}',
                           EXIT_CANCELLED if reason == 'cancelled' else EXIT_REFUSED)
        with Deferred():
            journal.record_resume('force-uncancel', at=now())
    if journal.attempts and journal.attempts[-1]['status'] == 'unverified':
        # The runner died between the exit and its verdict; the exit metadata decides it.
        last = aj.load(directory / 'journal')['attempts'][-1]
        with Deferred():
            journal.record_verdict(last['index'], classify(last['metadata']),
                                   dict(attempt_id=last['metadata']['attempt_id'], recovered=True))
    enforce_mode(m, journal, directory.name)
    limits, retries = m['run']['limits'], m['run'].get('retries', 0)
    plan = journal.header['plan']
    (directory / 'scratch').mkdir(exist_ok=True)
    while (work := _next_work(journal, retries)) is not None:
        index, try_ = work
        cell, aid = plan[index], attempt_id(directory.name, index, try_)
        if cancel_file.exists():
            with Deferred():
                journal.record_stop('cancelled', at=now(), boundary='between-attempts', next_attempt=aid)
            return EXIT_CANCELLED
        refusal = journal.refusal(limits['wall_seconds'] + limits.get('kill_after_seconds', 60))
        arm = next(a for a in m['arms'] if a['name'] == cell['arm'])
        actual = sha256_file(binary_path(directory, arm))
        if refusal is None and actual != arm['sha256']:
            refusal = dict(reason='binary-mismatch', arm=arm['name'], path=str(binary_path(directory, arm)),
                           expected=arm['sha256'], actual=actual)
        inst = next(i for i in m['instances'] if i['name'] == cell['instance'])
        if refusal is None and inst.get('path') and sha256_file(input_path(directory, inst)) != inst['sha256']:
            refusal = dict(reason='input-mismatch', instance=inst['name'], expected=inst['sha256'])
        if refusal is not None:
            with Deferred():
                journal.record_stop(refusal.pop('reason'), attempt=aid, at=now(), **refusal)
            raise JobError(f'{aid}: refused, {journal_stop(directory)}', EXIT_REFUSED)
        cpus = attempt_cpus(m, cell['workers'])
        aj._atomic_write(directory / 'current.json', canonical(dict(
            attempt=aid, index=index, cell=cell, runner_pid=os.getpid(), started=now(),
            started_unix=time.time())))
        command = argv(m, cell, directory)
        guard = None
        if limits.get('rss_bytes'):
            guard = (Path(command[0]).name[:15], command[0], limits['rss_bytes'] // 1024)
        load = os.getloadavg()[0]
        r = run_attempt(m, command, cpus, guard, cancel_file, directory)
        metadata = dict(attempt_id=aid, attempt_try=try_, cpus=cpus, argv=command, binary_sha256=actual, load_start=load,
                        process_wall_ns=r['process_wall_ns'], wall_seconds=r['process_wall_ns'] / 1e9,
                        cpu_seconds=r['cpu_seconds'], harness_cpu_seconds=r['harness_cpu_seconds'],
                        observed_peak_rss_bytes=r['peak_rss_bytes'],
                        exit=r['returncode'], stop='cancelled' if r['stopped'] else None,
                        guard=dict(wall_seconds=limits['wall_seconds'], rss_bytes=limits.get('rss_bytes'),
                                   rss_guard_rc=r['rss_guard_rc'], rss_guard_stderr=r['rss_guard_stderr']),
                        before=r['before'], after=r['after'], freq=r['freq'],
                        contamination=contamination(r, m, directory.name))
        status = classify(metadata)
        with Deferred():
            journal.record_exit(index, cell, r['stdout'], r['stderr'], metadata, try_=try_)
            journal.record_verdict(index, status, dict(attempt_id=aid))
        (directory / 'current.json').unlink(missing_ok=True)
        print(aid, cell['arm'], cell['instance'], f"w={cell['workers']}", status,
              f"{metadata['wall_seconds']:.3f}s", flush=True)
        if status == 'cancelled':
            with Deferred():
                journal.record_stop('cancelled', at=now(), boundary='in-attempt', attempt=aid)
            return EXIT_CANCELLED
    with Deferred():
        journal.record_stop('complete', at=now(), attempts=len(journal.attempts),
                            contamination=session_contamination(journal, m, directory.name))
    return 0


def journal_stop(directory):
    stop = aj.load(directory / 'journal')['stop']
    return ' '.join([stop['reason'], *(f'{k}={v}' for k, v in sorted(stop.items()) if k not in ('reason', 'at'))])


def launch(directory, force_uncancel):
    """Exec the runner under `bench-reserve run`: the reservation check, the zbbench.slice scope and
    the benchlock for the whole job: CCD-scoped in dev mode, exclusive in publication mode (§11.2),
    so no other campaign runs anywhere on the machine beside a publication figure."""
    m = load_manifest(directory)
    reserve = os.environ.get('ZEEBRA_BENCH_JOB_RESERVE', str(TOOLS / 'bench-reserve.sh'))
    inner = [sys.executable, str(Path(__file__).resolve()), '_run', directory.name]
    if force_uncancel:
        inner.append('--force-uncancel')
    env = dict(os.environ)
    env.pop('ZEEBRA_BENCH_RESERVE_EXCLUSIVE', None)
    if m['mode'] == 'publication':
        env['ZEEBRA_BENCH_RESERVE_EXCLUSIVE'] = '1'
    sys.stdout.flush()
    os.execvpe(reserve, [reserve, 'run', lock_owner(directory.name), m['run']['cpus'], *inner], env)


def start(directory, resume, force_uncancel):
    started = directory / 'started'
    if resume:
        if not started.exists():
            raise JobError(f'job {directory.name} never started; use run')
        s = job_status(directory)
        if s['state'] in ('running', 'waiting-for-lock'):
            raise JobError(f'job {directory.name} is {s["state"]}', EXIT_BUSY)
        if s['state'] == 'cancelled' and not force_uncancel:
            raise JobError(f'job {directory.name} was cancelled; resume --force-uncancel to continue', EXIT_CANCELLED)
        started.write_text(f'{os.getpid()} {now()}\n')
    else:
        try:
            fd = os.open(started, os.O_WRONLY | os.O_CREAT | os.O_EXCL)
        except FileExistsError:
            raise JobError(f'job {directory.name} has already started; use resume') from None
        os.write(fd, f'{os.getpid()} {now()}\n'.encode())
        os.close(fd)
    launch(directory, force_uncancel)


def next_queued():
    queue = jobs_root() / 'queue'
    seen = []
    for line in queue.read_text().splitlines() if queue.exists() else []:
        job_id = line.split()[-1]
        if job_id not in seen and (jobs_root() / job_id / 'manifest.json').exists() \
                and not (jobs_root() / job_id / 'started').exists():
            seen.append(job_id)
    for job_id in seen:
        try:
            fd = os.open(jobs_root() / job_id / 'started', os.O_WRONLY | os.O_CREAT | os.O_EXCL)
        except FileExistsError:
            continue  # another `run --next` took it first
        os.write(fd, f'{os.getpid()} {now()}\n'.encode())
        os.close(fd)
        return jobs_root() / job_id
    return None


def main(args=None):
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    sub = p.add_subparsers(dest='command', required=True)
    sub.add_parser('submit').add_argument('manifest', type=Path)
    s = sub.add_parser('status')
    s.add_argument('job', nargs='?')
    s.add_argument('--json', action='store_true')
    r = sub.add_parser('run')
    g = r.add_mutually_exclusive_group(required=True)
    g.add_argument('job', nargs='?')
    g.add_argument('--next', action='store_true', help='take the oldest queued job')
    for name in ('resume', '_run'):
        x = sub.add_parser(name)
        x.add_argument('job')
        x.add_argument('--force-uncancel', action='store_true')
    sub.add_parser('cancel').add_argument('job')
    rp = sub.add_parser('report')
    rp.add_argument('job')
    rp.add_argument('--json', action='store_true')
    rp.add_argument('--baseline', help='the arm every other arm is divided by (default: the first)')
    rp.add_argument('--bound', type=float, default=1.05, help='regression bound on the upper limit (plan §12.2)')
    sc = sub.add_parser('scoreboard')
    sc.add_argument('job')
    sc.add_argument('--machine', default=os.uname().nodename)
    sc.add_argument('--append', type=Path, help='research/competitive/results/history.json')
    a = p.parse_args(args)
    try:
        if a.command == 'submit':
            print(submit(a.manifest))
        elif a.command == 'status':
            root = jobs_root()
            dirs = [job_dir(a.job)] if a.job else sorted(d for d in root.glob('*') if (d / 'manifest.json').is_file()) \
                if root.exists() else []
            for s in map(job_status, dirs):
                print(json.dumps(s, sort_keys=True) if a.json else _status_line(s))
        elif a.command == 'run':
            directory = next_queued() if a.next else job_dir(a.job)
            if directory is None:
                print('bench-job: no queued job', file=sys.stderr)
                return 1
            if a.next:
                launch(directory, False)
            start(directory, False, False)
        elif a.command == 'resume':
            start(job_dir(a.job), True, a.force_uncancel)
        elif a.command == '_run':
            return run_job(job_dir(a.job), a.force_uncancel)
        elif a.command == 'cancel':
            print(cancel(job_dir(a.job)))
        elif a.command == 'report':
            d = job_dir(a.job)
            doc = summarize(aj.load(d / 'journal'), load_manifest(d), baseline=a.baseline, bound=a.bound)
            doc.pop('timed')
            print(json.dumps(doc, indent=1, sort_keys=True) if a.json else render(doc).rstrip('\n'))
        elif a.command == 'scoreboard':
            d = job_dir(a.job)
            rows = competitive_rows(aj.load(d / 'journal'), load_manifest(d), machine=a.machine)
            if a.append:
                append_history(a.append, rows)
            print(json.dumps(rows, indent=1))
    except JobError as e:
        print(f'bench-job: {e}', file=sys.stderr)
        return e.code
    return 0


if __name__ == '__main__':
    sys.exit(main())
